---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Content as EnglishLicense } from "../content/licenses/netbaiot.en.md";
import { Content as ChineseLicense } from "../content/licenses/netbaiot.zh.md";
import { useCopy } from "../i18n/copy";
import { localizePath } from "../i18n/locale";

const { locale } = useCopy(Astro.url.pathname);
const title = locale === "zh" ? "NetbaIoT 商业软件许可" : "NetbaIoT Commercial Software License";
const description = locale === "zh" ? "NetbaIoT 商业软件许可的完整条款。" : "Full terms of the NetbaIoT Commercial Software License.";
---

<BaseLayout title={title} description={description}>
  <div class="wrap content-page">
    <p class="kicker">{locale === "zh" ? "许可" : "License"}</p>
    <h1 class="page-title">{title}</h1>
    <p><a href={localizePath("/iot/license", locale === "zh" ? "en" : "zh")} hreflang={locale === "zh" ? "en" : "zh-CN"}>{locale === "zh" ? "English" : "中文"}</a></p>
    <article class="prose">
      {locale === "zh" ? <ChineseLicense /> : <EnglishLicense />}
    </article>
  </div>
</BaseLayout>

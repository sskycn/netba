---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageFrame from "../components/PageFrame.astro";
import Faq from "../components/Faq.astro";
import { site } from "../data/site";
import { useCopy } from "../i18n/copy";
import { localizePath } from "../i18n/locale";

const { locale, t } = useCopy(Astro.url.pathname);
---

<BaseLayout faqs={t.home.faq}>
  <div class="wrap">
    <section class="hero" style="padding-top: 3.4rem; padding-bottom: 1rem;">
      <div>
        <p class="eyebrow">
          <span class="chip">NetbaDB</span>
          <span class="chip teal">NetbaIoT</span>
          <span class="chip moss">AGPL-3.0</span>
        </p>
        <h1 set:html={t.home.heroHtml} />
        <p class="lede">{t.home.lede}</p>
        <div class="actions">
          <a class="btn btn-primary" href={localizePath("/start", locale)}>{t.home.ctaDb}</a>
          <a class="btn btn-ghost" href={localizePath("/iot/start", locale)}>{t.home.ctaIot}</a>
        </div>
      </div>
      <PageFrame />
    </section>
  </div>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t.home.productsKicker}</p>
          <h2>{t.home.productsTitle}</h2>
        </div>
        <p>{t.home.productsDeck}</p>
      </div>
      <div class="grid-2">
        <article class="card">
          <h3>{t.home.dbCardTitle}</h3>
          <p>{t.home.dbCardBody}</p>
          <ul>
            {t.home.dbPoints.map((item) => <li>{item}</li>)}
          </ul>
          <p>
            <a href={localizePath("/start", locale)}>{t.home.ctaDb}</a>
            {" · "}
            <a href={site.db.github}>sskycn/netbadb</a>
          </p>
        </article>
        <article class="card">
          <h3>{t.home.iotCardTitle}</h3>
          <p>{t.home.iotCardBody}</p>
          <ul>
            {t.home.iotPoints.map((item) => <li>{item}</li>)}
          </ul>
          <p>
            <a href={localizePath("/iot/start", locale)}>{t.home.ctaIot}</a>
            {" · "}
            <a href={site.iot.github}>sskycn/netbaiot</a>
          </p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="kicker">{t.home.howKicker}</p>
          <h2>{t.home.howTitle}</h2>
        </div>
      </div>
      <div class="grid-2">
        <article class="card">
          <h3>{t.home.dbHowTitle}</h3>
          <ol class="howto">
            {t.home.dbHow.map((item) => <li>{item}</li>)}
          </ol>
          <p><a href={localizePath("/start", locale)}>{t.home.ctaDb}</a></p>
        </article>
        <article class="card">
          <h3>{t.home.iotHowTitle}</h3>
          <ol class="howto">
            {t.home.iotHow.map((item) => <li>{item}</li>)}
          </ol>
          <p><a href={localizePath("/iot/start", locale)}>{t.home.ctaIot}</a></p>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <Faq title={t.chrome.faqTitle} items={t.home.faq} />
    </div>
  </section>
</BaseLayout>

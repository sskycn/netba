---
import BaseLayout from "../layouts/BaseLayout.astro";
import { iotCrates } from "../data/iot";
import { useCopy } from "../i18n/copy";

const { locale, t } = useCopy(Astro.url.pathname);
---

<BaseLayout title={t.iotArchitecture.title} description={t.iotArchitecture.description}>
  <div class="wrap content-page">
    <p class="kicker">{t.iotArchitecture.kicker}</p>
    <h1 class="page-title" set:html={t.iotArchitecture.heroHtml} />
    <p class="page-deck">{t.iotArchitecture.deck}</p>

    <div class="prose">
      <h2>{t.iotArchitecture.pipelineTitle}</h2>
    </div>
    <div class="diagram">
      <pre>
HTTP / MQTT / TCP / UDP devices
          |
          v
transport framing and lifecycle
          |
          v
authentication / ACL / bound AuthContext
          |
          v
versioned DeviceCodec
          |
          v
DeviceEvent(event_id)
          |
          v
bounded EventBus and atomic required-sink admission
          |
          +------ confirmed HTTP webhook
          |
          +------ confirmed framed TCP/RPC stream</pre>
    </div>

    <div class="prose">
      <h2>{t.iotArchitecture.cratesTitle}</h2>
      <p>{t.iotArchitecture.cratesDeck}</p>
    </div>
    <div class="crate-grid">
      {
        iotCrates.map((crate) => (
          <article class="crate">
            <h3>{crate.name}</h3>
            <p>{crate.role[locale]}</p>
            <div class="deps">{crate.path}</div>
          </article>
        ))
      }
    </div>

    <div class="prose">
      <h2>{t.iotArchitecture.mqttTitle}</h2>
      <p>{t.iotArchitecture.mqttBody}</p>
    </div>
    <div class="diagram">
      <pre>{`v1/t/{tenant}/p/{product}/d/{device}/up
v1/t/{tenant}/p/{product}/d/{device}/up_ack
v1/t/{tenant}/p/{product}/d/{device}/down
v1/t/{tenant}/p/{product}/d/{device}/down_ack`}</pre>
    </div>

    <div class="callout note">
      <h3>{t.iotArchitecture.decisionTitle}</h3>
      <p class="muted">{t.iotArchitecture.decisionBody}</p>
    </div>
  </div>
</BaseLayout>

---
import { useCopy } from "../i18n/copy";
import { site } from "../data/site";

const { t } = useCopy(Astro.url.pathname);
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <strong class="serif">{site.name}</strong>
      {" "}{t.chrome.footerBody}
    </div>
    <div>
      <a href={site.github}>sskycn/netbadb</a>
      {" · "}{site.license}
      {" · "}{t.chrome.footerStatic}
    </div>
  </div>
</footer>

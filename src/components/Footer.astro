---
import { useCopy } from "../i18n/copy";
import { localizePath } from "../i18n/locale";
import { site } from "../data/site";

const { locale, t } = useCopy(Astro.url.pathname);
---

<footer class="site-footer">
  <div class="wrap">
    <nav class="footer-nav" aria-label={t.chrome.footerNavAria}>
      {
        t.chrome.footerNav.map((item) => (
          <a href={localizePath(item.href, locale)}>{item.label}</a>
        ))
      }
    </nav>
    <div class="footer-inner">
      <div>
        <strong class="serif">{site.name}</strong>
        <p class="footer-note">{t.chrome.footerBody}</p>
      </div>
      <div>
        <a href={localizePath("/start", locale)}>NetbaDB</a>
        {" · "}
        <a href={localizePath("/iot", locale)}>NetbaIoT</a>
        {" · "}NetbaDB: <a href={localizePath("/license", locale)}>{site.license}</a> · NetbaIoT: <a href={localizePath("/iot/license", locale)}>{site.iot.license}</a>
      </div>
    </div>
  </div>
</footer>

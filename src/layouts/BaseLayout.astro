---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import LocaleRedirect from "../components/LocaleRedirect.astro";
import JsonLd from "../components/JsonLd.astro";
import { useCopy } from "../i18n/copy";
import { htmlLang, localizePath, stripLocale } from "../i18n/locale";
import { site } from "../data/site";
import {
  absoluteUrl,
  breadcrumbJsonLd,
  faqJsonLd,
  ogImage,
  organizationJsonLd,
  softwareJsonLd,
  websiteJsonLd,
  type FaqItem,
} from "../data/seo";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
  notFound?: boolean;
  faqs?: FaqItem[];
};

const { title, description, notFound = false, faqs = [] } = Astro.props;
const { locale, t } = useCopy(Astro.url.pathname);
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${t.meta.title}`;
const pageDescription = description ?? t.meta.description;
const rawPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const path = stripLocale(rawPath);
const canonical = new URL(rawPath, Astro.site ?? site.url).href;
const enUrl = new URL(localizePath(path, "en"), Astro.site ?? site.url).href;
const zhUrl = new URL(localizePath(path, "zh"), Astro.site ?? site.url).href;
const image = absoluteUrl(ogImage.path);
const jsonLd = [
  organizationJsonLd(),
  websiteJsonLd(),
  ...softwareJsonLd(),
  breadcrumbJsonLd(
    path === "/"
      ? [{ name: site.name, path: "/" }]
      : [
          { name: site.name, path: "/" },
          { name: title ?? t.meta.title, path },
        ],
    locale,
  ),
  ...(faqs.length ? [faqJsonLd(faqs)] : []),
];
---

<!doctype html>
<html lang={htmlLang[locale]} data-404={notFound ? "true" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <LocaleRedirect />
    {notFound && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#0c0d0b" />
    <meta name="author" content="Netba" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={htmlLang[locale] === "zh-CN" ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={locale === "en" ? "zh_CN" : "en_US"} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content={ogImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&family=Instrument+Serif:ital@0;1&family=Source+Sans+3:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <JsonLd data={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">{t.chrome.skip}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
